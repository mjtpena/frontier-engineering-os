{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FEOS AI eval summary",
  "type": "object",
  "required": [
    "cases",
    "metrics"
  ],
  "properties": {
    "cases": {
      "type": "integer",
      "minimum": 0
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "slices": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "number"
        }
      }
    }
  }
}