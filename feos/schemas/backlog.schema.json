{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FEOS backlog",
  "type": "object",
  "required": [
    "version",
    "epics",
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string"
    },
    "release": {
      "type": "string"
    },
    "epics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "features"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EP-\\d{2,}$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "features": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "stories"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^FT-\\d{3,}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 3
                },
                "stories": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "title",
                      "covers",
                      "acceptance"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^ST-\\d{3,}$"
                      },
                      "title": {
                        "type": "string",
                        "minLength": 3
                      },
                      "covers": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "pattern": "^N?FR-\\d{3,}$"
                        }
                      },
                      "acceptance": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 10
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "story",
          "title",
          "type",
          "estimate_hours",
          "status",
          "depends_on",
          "covers",
          "acceptance"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TK-\\d{3,}$"
          },
          "story": {
            "type": "string",
            "pattern": "^ST-\\d{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "type": {
            "enum": [
              "contract",
              "test",
              "impl",
              "infra",
              "docs",
              "spike"
            ]
          },
          "estimate_hours": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 8
          },
          "status": {
            "enum": [
              "backlog",
              "ready",
              "in_progress",
              "review",
              "done",
              "blocked"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^TK-\\d{3,}$"
            }
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^N?FR-\\d{3,}$"
            }
          },
          "files_hint": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "instructions": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}