{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FEOS artifact front-matter",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "owner",
    "version",
    "trace"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 2
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "superseded",
        "proposed",
        "accepted",
        "rejected"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": [
        "string",
        "number"
      ]
    },
    "trace": {
      "type": "array"
    }
  }
}