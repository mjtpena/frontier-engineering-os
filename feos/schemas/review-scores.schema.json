{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FEOS reviewer scores block",
  "type": "object",
  "required": [
    "scores"
  ],
  "properties": {
    "scores": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "score",
          "evidence"
        ],
        "properties": {
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "na": {
            "type": "boolean"
          }
        }
      },
      "minProperties": 1
    },
    "hard_constraints": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    }
  }
}